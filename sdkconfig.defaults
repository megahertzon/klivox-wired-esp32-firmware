# Klivox Wired ESP32 baseline. Existing sdkconfig values take precedence.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_EXAMPLE_PROV_TRANSPORT_BLE=y
CONFIG_EXAMPLE_PROV_SECURITY_VERSION_2=y
CONFIG_EXAMPLE_PROV_SEC2_DEV_MODE=y

# Keep RX ISR in IRAM; place TX ISR and encoders in flash so Wi-Fi/BLE,
# DS18B20 and IR capture fit together. RMT TX cache-safe mode stays off.
CONFIG_RMT_TX_ISR_HANDLER_IN_IRAM=n
CONFIG_RMT_ENCODER_FUNC_IN_IRAM=n
